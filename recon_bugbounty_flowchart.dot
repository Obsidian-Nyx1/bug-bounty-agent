digraph ReconBugBounty {
  graph [rankdir=TB, splines=true, nodesep=0.5, ranksep=0.7, bgcolor="white"];
  node [shape=box, style="rounded,filled", fillcolor="#f7fafc", color="#2d3748", fontname="Helvetica", fontsize=11];
  edge [color="#4a5568", arrowsize=0.7];

  A [label="Recon"];
  B [label="Scope & Policy Check"];
  C [label="Recon Collection"];
  D [label="Normalize & Correlate"];
  E [label="Prioritize"];
  F [label="Safe Validation"];
  G [label="L-Point", shape=circle, width=1.0, fixedsize=true, fillcolor="#edf2f7"];
  H [label="Report", fillcolor="#e6fffa"];

  A -> B;
  A -> C;
  A -> D;
  A -> E;
  A -> F;

  B1 [label="In-scope assets", fontsize=10];
  B2 [label="Out-of-scope filter", fontsize=10];
  B3 [label="Program rules / rate limits", fontsize=10];
  B -> B1;
  B -> B2;
  B -> B3;

  C1 [label="Searching platform", fontsize=10];
  C2 [label="Files on platform", fontsize=10];
  C3 [label="Available internet info", fontsize=10];
  C4 [label="Social discussions", fontsize=10];
  C5 [label="DNS / CT / WHOIS", fontsize=10];
  C6 [label="Subdomains / IP / ASN", fontsize=10];
  C -> C1;
  C -> C2;
  C -> C3;
  C -> C4;
  C -> C5;
  C -> C6;

  D1 [label="Parse metadata", fontsize=10];
  D2 [label="Deduplicate", fontsize=10];
  D3 [label="Tech fingerprinting", fontsize=10];
  D4 [label="Link assets", fontsize=10];
  D -> D1;
  D -> D2;
  D -> D3;
  D -> D4;

  E1 [label="Exposure score", fontsize=10];
  E2 [label="Confidence score", fontsize=10];
  E3 [label="High-value target rank", fontsize=10];
  E -> E1;
  E -> E2;
  E -> E3;

  F1 [label="Non-destructive checks", fontsize=10];
  F2 [label="Low-rate probing", fontsize=10];
  F3 [label="Evidence capture", fontsize=10];
  F -> F1;
  F -> F2;
  F -> F3;

  C -> G;
  D -> G;
  E -> G;
  F -> G;
  G -> H;
}
